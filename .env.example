# Prometheus RIG — environment template.
# Copy to `.env`, fill in your key, then in WSL2:   set -a && source .env && set +a
# NEVER commit a real key. Keys live only in your shell / .env (gitignored).

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "openai" = any OpenAI-compatible endpoint (NVIDIA hosted by default).
# "mock"   = deterministic offline provider (no network, no key) for testing.
PROMETHEUS_LLM_PROVIDER=openai

# Backend base URL. DEFAULT = NVIDIA hosted.
# To use a LOCAL NIM instead, change ONLY this line to:  http://localhost:8000/v1
PROMETHEUS_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model id your key / endpoint can serve. Example NVIDIA-hosted model below —
# set to whatever your account (or your local NIM) exposes.
PROMETHEUS_LLM_MODEL=meta/llama-3.1-8b-instruct

# Name of the env var that holds the API key (the key VALUE goes in NVIDIA_API_KEY).
PROMETHEUS_API_KEY_ENV=NVIDIA_API_KEY

# Your NVIDIA API key (starts with nvapi-). Leave blank here; export it in your shell:
#   export NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# * Safety budgets (max_tool_calls / max_writes / max_external_calls /
#   max_irreversible / require_human_for_irreversible) are set in prometheus.yaml,
#   and the tool-call budget can be overridden per-run with --max-tool-calls.
# * A local NIM needs no key; keep PROMETHEUS_LLM_PROVIDER=openai and just point
#   PROMETHEUS_LLM_BASE_URL at http://localhost:8000/v1 (see RUN.md GPU check).
